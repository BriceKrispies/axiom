burst dirt.0
count 8.0 3
pool lit

# The plume — `impacts.js:604-635`. Spawn points are spread over a small
# disc on the surface rather than stacked on the impact point, so the puff
# reads as a crater rather than a jet.
at = point
n = normal
energy = energy
dir = cone n 0.75 0.55
drawn = range 1.6 4.2
speed = mul drawn energy
spread = disc_on n 0.06
from = add3 at spread
lifted = offset from.y 0.01
vel = mul3 dir speed
index = index
phase = mod index 3.0
tile = select phase 0.5 SMOKE_B DUST
near = range 0.06 0.13
size0 = mul near energy
far = range 0.55 1.0
size1 = mul far energy
life = range 0.8 1.5
drag = range 2.2 3.2
spun = unit
rot = scale spun 6.283185307179586
signed = signed
spin = scale signed 1.1
alpha = range 0.6 0.95
seed = unit

fields
x from.x
y lifted
z from.z
vx vel.x
vy vel.y
vz vel.z
tile tile
size0 size0
size1 size1
life life
drag drag
rot rot
spin spin
alpha alpha
seed seed
size_curve 0.5
gravity -1.6
r0 0.3
g0 0.22
b0 0.15
r1 0.255
g1 0.187
b1 0.1275
alpha_curve 1.4
soft 0.14
turb 0.08
turb_freq 1.6

burst dirt.1
count 13.0 5
pool lit

