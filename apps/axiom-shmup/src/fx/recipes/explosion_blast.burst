# The second half of an explosion — `explosions.js:140-262`. Runs after the
# haze ring, which draws from the shared stream between the two halves.

burst shockwave
count 0 1
pool add

at = point
r = radius
size0 = scale r 0.35
size1 = scale r 2.4
seed = unit

fields
x at.x
y at.y
z at.z
tile RING
size0 size0
size1 size1
size_curve 0.42
life 0.2
drag 6.0
r0 1.0
g0 0.9
b0 0.78
i0 3.2
r1 1.0
g1 0.6
b1 0.3
i1 0.0
alpha_curve 1.1
soft 1.2
seed seed

burst ground-ring
# The only burst in the corpus laid out around a circle rather than sampled in
# a cone: each particle takes its own slot on the ring — `i / n` of a full turn
# — and jitters a fifth of a radian off it, so the dust reads as a wave leaving
# the crater and not as a spray.
count 11 5
pool lit

at = point
r = radius
i = index
n = particles
turn = div i n
a0 = scale turn 6.283185307179586
jitter = range -0.2 0.2
a = add a0 jitter
dx = cos a
dz = sin a
sp_drawn = range 4.0 9.0
r_quarter = scale r 0.25
sp = mul sp_drawn r_quarter
r_fifth = scale r 0.2
xoff = mul dx r_fifth
zoff = mul dz r_fifth
x = add at.x xoff
y = mad r -0.05 at.y
z = add at.z zoff
vx = mul dx sp
vy = range 0.3 1.4
vz = mul dz sp
phase = mod i 3
tile = select phase 0.5 SMOKE_B DUST
s0_drawn = range 0.12 0.22
size0 = mul r s0_drawn
s1_drawn = range 0.55 0.95
size1 = mul r s1_drawn
life = range 0.9 1.8
drag = range 2.4 3.6
spun = unit
rot = scale spun 6.283185307179586
sgn = signed
spin = scale sgn 1.0
alpha = range 0.4 0.7
seed = unit

fields
x x
y y
z z
vx vx
vy vy
vz vz
tile tile
size0 size0
size1 size1
size_curve 0.45
life life
drag drag
gravity -0.5
rot rot
spin spin
r0 0.42
g0 0.36
b0 0.29
r1 0.34
g1 0.3
b1 0.25
alpha alpha
alpha_curve 1.5
soft 0.5
turb 0.1
turb_freq 1.4
seed seed

burst debris
# Speed here scales with `0.6 + r / 8`, not with `r` — a bigger charge throws
# debris faster but not proportionally faster, or a large blast would fling
# chips out of the level.
count 26 10
pool lit

at = point
up = up
r = radius
dir = cone up 1.35 0.8
sp_drawn = range 6.0 20.0
r_eighth = scale r 0.125
gain = offset r_eighth 0.6
sp = mul sp_drawn gain
y = offset at.y 0.05
vel = mul3 dir sp
shape = unit
tile = select shape 0.3 SPLINTER CHIP
size = range 0.01 0.05
life = range 0.7 1.8
spun = unit
rot = scale spun 6.283185307179586
sgn = signed
spin = scale sgn 26.0
seed = unit

fields
x at.x
y y
z at.z
vx vel.x
vy vel.y
vz vel.z
tile tile
size0 size
size1 size
life life
drag 0.4
gravity -19.0
rot rot
spin spin
r0 0.24
g0 0.21
b0 0.18
r1 0.2
g1 0.18
b1 0.16
alpha_curve 0.3
soft 0.06
seed seed

burst embers
# Riding the debris, and the one burst whose speed does not scale with the
# charge at all.
count 14 5
pool add

at = point
up = up
dir = cone up 1.4 0.9
sp = range 4.0 14.0
y = offset at.y 0.05
vel = mul3 dir sp
size0 = range 0.012 0.03
size1 = scale size0 0.4
life = range 0.5 1.4
i0 = range 8.0 20.0
seed = unit

fields
x at.x
y y
z at.z
vx vel.x
vy vel.y
vz vel.z
tile STREAK
size0 size0
size1 size1
stretch 1.1
life life
drag 1.1
gravity -13.0
r0 1.0
g0 0.6
b0 0.22
i0 i0
r1 1.0
g1 0.18
b1 0.03
i1 0.2
flags 1.0
alpha_curve 0.6
soft 0.06
seed seed
