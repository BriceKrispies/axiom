# The first half of an explosion — `explosions.js:35-140`.
#
# Everything here scales by `radius`, which is why radius is an input rather
# than there being one recipe per charge size. In practice that means an
# explosion has far fewer true constants than an impact does: a size, a
# turbulence, a spawn offset are all `r * k`, and `r` is only known at the
# moment the charge goes off.
#
# Split from the second half because `haze_ring` fires between them and draws
# from the shared stream. Draw order is the contract, so the split is where the
# source puts it and not where it would be tidiest.
#
# Associativity is written out deliberately. `vx * r * 0.12` is `(vx * r) *
# 0.12`, and folding it to `vx * (r * 0.12)` is a different value in floating
# point — the kind of difference the ledger catches and the eye does not.

burst core-flash
count 0 1
pool add

at = point
r = radius
size0 = scale r 0.35
size1 = scale r 1.5
seed = unit

fields
x at.x
y at.y
z at.z
tile FLASH_CORE
size0 size0
size1 size1
size_curve 0.3
life 0.085
drag 5.0
r0 1.0
g0 0.95
b0 0.85
i0 85.0
r1 1.0
g1 0.42
b1 0.1
i1 0.0
alpha_curve 0.5
soft 0.5
seed seed

burst fireball
count 12 5
pool add

at = point
up = up
r = radius
dir = cone up 1.5 0.6
sp_drawn = range 1.5 5.5
r_quarter = scale r 0.25
sp = mul sp_drawn r_quarter
# The spawn is spread over a small disc on the blast plane, so the fireball
# reads as a volume rather than a point source.
disc_r = scale r 0.16
spread = disc_on up disc_r
x = add at.x spread.x
y0 = add at.y spread.y
y = mad r 0.05 y0
z = add at.z spread.z
vel = mul3 dir sp
vy = offset vel.y 1.4
s0_drawn = range 0.18 0.34
size0 = mul r s0_drawn
s1_drawn = range 0.7 1.15
size1 = mul r s1_drawn
life = range 0.3 0.62
delay = range 0.0 0.06
drag = range 2.6 4.2
spun = unit
rot = scale spun 6.283185307179586
sgn = signed
spin = scale sgn 2.2
g0 = range 0.7 0.92
b0 = range 0.4 0.62
i0 = range 7.0 17.0
turb = scale r 0.05
seed = unit

fields
x x
y y
z z
vx vel.x
vy vy
vz vel.z
tile FIRE
size0 size0
size1 size1
size_curve 0.34
life life
delay delay
drag drag
gravity 2.2
rot rot
spin spin
r0 1.0
g0 g0
b0 b0
i0 i0
r1 1.0
g1 0.22
b1 0.04
i1 0.3
alpha_curve 0.55
soft 0.6
turb turb
turb_freq 2.4
seed seed

burst boil
# Dark hot smoke coming off the fireball immediately, alternating between the
# two smoke tiles so the column does not read as one repeated sprite.
count 9 4
pool lit

at = point
up = up
r = radius
dir = cone up 1.4 0.7
sp_drawn = range 1.2 4.0
r_quarter = scale r 0.25
sp = mul sp_drawn r_quarter
xr = mul dir.x r
zr = mul dir.z r
xoff = scale xr 0.12
zoff = scale zr 0.12
x = add at.x xoff
y = mad r 0.08 at.y
z = add at.z zoff
vel = mul3 dir sp
vy = offset vel.y 1.0
i = index
phase = mod i 2
tile = select phase 0.5 SMOKE_B SMOKE_A
s0_drawn = range 0.2 0.34
size0 = mul r s0_drawn
s1_drawn = range 0.8 1.35
size1 = mul r s1_drawn
life = range 1.1 2.2
delay = range 0.03 0.16
spun = unit
rot = scale spun 6.283185307179586
sgn = signed
spin = scale sgn 0.9
alpha = range 0.55 0.85
turb = scale r 0.06
seed = unit

fields
x x
y y
z z
vx vel.x
vy vy
vz vel.z
tile tile
size0 size0
size1 size1
size_curve 0.5
life life
delay delay
drag 1.9
gravity 0.9
rot rot
spin spin
r0 0.1
g0 0.095
b0 0.09
r1 0.19
g1 0.185
b1 0.18
alpha alpha
alpha_curve 1.5
soft 0.7
turb turb
turb_freq 1.1
seed seed
