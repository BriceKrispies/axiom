burst flesh.0
count 9.0 4
pool lit

# Aerosol mist — `impacts.js:800-826`, spawned a couple of centimetres
# *inside* the surface so the cone reads as coming out of the wound.
at = point
n = normal
inc = incident
back = scale3 n -0.25
axis = mad3 inc 0.75 back
from = mad3 n -0.02 at
dir = cone axis 0.95 0.8
speed = range 1.2 4.5
vel = mul3 dir speed
rise = offset vel.y 0.3
index = index
phase = mod index 3.0
tile = select phase 0.5 SMOKE_A MIST
energy = energy
near = range 0.035 0.075
size0 = mul near energy
far = range 0.16 0.34
size1 = mul far energy
life = range 0.3 0.62
drag = range 4.5 6.5
spun = unit
rot = scale spun 6.283185307179586
signed = signed
spin = scale signed 2.0
alpha = range 0.6 0.95
seed = unit

fields
x from.x
y from.y
z from.z
vx vel.x
vy rise
vz vel.z
tile tile
size0 size0
size1 size1
life life
drag drag
rot rot
spin spin
alpha alpha
seed seed
size_curve 0.5
gravity -3.2
r0 0.34
g0 0.035
b0 0.03
r1 0.16
g1 0.016
b1 0.014
alpha_curve 1.5
soft 0.08
turb 0.04
turb_freq 3.0

burst flesh.1
count 14.0 5
pool lit

# Droplets — `impacts.js:828-839`. Heavier, faster, stretched along their
# own velocity, and thrown from the surface itself rather than behind it.
at = point
n = normal
inc = incident
back = scale3 n -0.25
axis = mad3 inc 0.75 back
dir = cone axis 1.1 1.2
speed = range 2.0 8.0
vel = mul3 dir speed
size = range 0.007 0.022
life = range 0.35 0.8
seed = unit

fields
x at.x
y at.y
z at.z
vx vel.x
vy vel.y
vz vel.z
size0 size
size1 size
life life
seed seed
tile DROPLET
stretch 0.6
drag 0.9
gravity -19.0
r0 0.3
g0 0.03
b0 0.025
r1 0.22
g1 0.022
b1 0.018
alpha 0.95
alpha_curve 0.35
soft 0.05
