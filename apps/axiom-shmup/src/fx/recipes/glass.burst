burst glass.0
count 14.0 5

# Shards, with the glint riding them — `impacts.js:669-710`.
at = point
n = normal
inc = incident
back = scale3 n -0.2
front = mad3 inc 0.8 back
flip = unit
sign = select flip 0.3 -1.0 1.0
axis = mul3 front sign
dir = cone axis 1.0 1.2
speed = range 2.5 8.0
vel = mul3 dir speed
shape = unit
tile = select shape 0.4 SPLINTER CHIP
size = range 0.01 0.038
life = range 0.7 1.4
spun = unit
rot = scale spun 6.283185307179586
signed = signed
spin = scale signed 30.0
seed = unit

fields
x at.x
y at.y
z at.z
vx vel.x
vy vel.y
vz vel.z
tile tile
size0 size
size1 size
life life
rot rot
spin spin
seed seed
drag 0.6
gravity -19.0
r0 0.72
g0 0.8
b0 0.84
r1 0.6
g1 0.68
b1 0.72
alpha 0.85
alpha_curve 0.3
soft 0.06

companion 0.55 add
# Everything from here belongs to the glint, and draws only if it lands.
glint_size = range 0.01 0.02
glint_i0 = range 3.0 8.0
fields
size0 glint_size
size1 glint_size
i0 glint_i0
tile SPARK
r0 0.85
g0 0.95
b0 1.0
r1 0.8
g1 0.9
b1 1.0
i1 0.2
alpha 1.0
alpha_curve 1.0
flags 1.0

burst glass.1
count 4.0 1
pool lit

# Aerosol — `impacts.js:713-723`. A fixed speed, so nothing is drawn for
# the velocity at all.
at = point
n = normal
inc = incident
back = scale3 n -0.2
axis = mad3 inc 0.8 back
dir = cone axis 1.2 0.7
vel = scale3 dir 1.6
size1 = range 0.28 0.45
life = range 0.35 0.7
spun = unit
rot = scale spun 6.283185307179586
seed = unit

fields
x at.x
y at.y
z at.z
vx vel.x
vy vel.y
vz vel.z
size1 size1
life life
rot rot
seed seed
tile MIST
