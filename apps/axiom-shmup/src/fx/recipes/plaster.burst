burst plaster.0
count 8.0 3
pool lit

# Powder — `impacts.js:339-388`.
at = point
n = normal
# Plaster's ejecta axis leans harder off the wall than wood's: the normal
# is weighted 1.3 before the average, so the puff stands off the surface.
r = reflected
lean = mad3 n 1.3 r
axis = scale3 lean 0.5
raw = cone axis 1.3 0.6
# Anything the cone threw into the wall is folded back out of it.
dir = toward_hemi raw n 0.05
speed = range 0.6 2.2
off = range 0.05 0.14
step = mul3 n off
from = add3 at step
vel = mul3 dir speed
rise = offset vel.y 0.4
energy = energy
index = index
odd = mod index 2.0
tile = select odd 0.5 MIST DUST
band = mod index 3.0
# `band == 0` is `band < 0.5`; `band == 2` is `band >= 1.5`.
near_k = select band 0.5 0.8 1.0
far_k = select band 1.5 1.0 1.3
near = range 0.05 0.11
near_e = mul near energy
size0 = mul near_e near_k
far = range 0.34 0.62
far_e = mul far energy
size1 = mul far_e far_k
mid_or_far = select band 1.5 0.48 0.78
size_curve = select band 0.5 0.3 mid_or_far
# The delay: none at all for the near band, which therefore draws nothing.
# `has_delay` is 1.0 exactly when the band is zero, so the gate — which
# opens on `< 0.5` — is closed for that band and open for the others.
is_near = select band 0.5 1.0 0.0
delay_hi = select band 1.5 0.1 0.22
delay_lo = const 0.02
gate is_near < 0.5
delay = range_between delay_lo delay_hi
end
life_lo_far = select band 1.5 0.7 1.4
life_lo = select band 0.5 0.25 life_lo_far
life_hi_far = select band 1.5 1.2 2.2
life_hi = select band 0.5 0.45 life_hi_far
life = range_between life_lo life_hi
drag_lo = select band 0.5 5.0 2.6
drag_hi = select band 0.5 7.0 3.8
drag = range_between drag_lo drag_hi
spun = unit
rot = scale spun 6.283185307179586
signed = signed
spin = scale signed 1.2
# Self-shading: `0.68 + 0.74 * max(dot(v, sun), 0)`, then the powder's
# colour scaled by it. The dot is against the *shaped* direction, before
# the speed is applied, exactly as the source does.
sun = sun
facing = dot dir sun
toward = max facing 0.0
lifted = scale toward 0.74
lit = offset lifted 0.68
r0 = scale lit 0.74
g0 = scale lit 0.63
b0 = scale lit 0.465
r1 = scale lit 0.63
g1 = scale lit 0.53
b1 = scale lit 0.385
alpha_k = select band 1.5 1.0 0.7
alpha_drawn = range 0.42 0.72
alpha = mul alpha_drawn alpha_k
seed = unit

fields
x from.x
y from.y
z from.z
vx vel.x
vy rise
vz vel.z
tile tile
size0 size0
size1 size1
size_curve size_curve
delay delay
life life
drag drag
rot rot
spin spin
r0 r0
g0 g0
b0 b0
r1 r1
g1 g1
b1 b1
alpha alpha
seed seed
gravity -0.55
alpha_curve 1.6
soft 0.09
turb 0.06
turb_freq 2.0

burst plaster.1
count 7.0 2
pool lit

# Crumbs — `impacts.js:390-408`.
at = point
n = normal
from = mad3 n 0.01 at
r = reflected
lean = mad3 n 1.3 r
axis = scale3 lean 0.5
dir = cone axis 0.95 1.3
speed = range 2.0 6.0
vel = mul3 dir speed
size = range 0.007 0.02
life = range 0.5 0.9
spun = unit
rot = scale spun 6.283185307179586
signed = signed
spin = scale signed 18.0
seed = unit

fields
x from.x
y from.y
z from.z
vx vel.x
vy vel.y
vz vel.z
size0 size
size1 size
life life
rot rot
spin spin
seed seed
tile CHIP
drag 0.5
gravity -19.0
r0 0.72
g0 0.65
b0 0.52
r1 0.64
g1 0.575
b1 0.46
alpha_curve 0.25
soft 0.06

burst plaster.2
count 4.0 2
pool lit

# Ejecta — `impacts.js:410-433`. A tight, fast jet straight back out.
at = point
n = normal
from = mad3 n 0.02 at
r = reflected
lean = mad3 n 1.3 r
axis = scale3 lean 0.5
dir = cone axis 0.32 1.6
speed = range 3.0 6.5
vel = mul3 dir speed
rise = offset vel.y 0.2
energy = energy
near = range 0.022 0.045
size0 = mul near energy
far = range 0.12 0.24
size1 = mul far energy
life = range 0.18 0.3
drag = range 6.0 9.0
spun = unit
rot = scale spun 6.283185307179586
signed = signed
spin = scale signed 2.2
alpha = range 0.35 0.6
seed = unit

fields
x from.x
y from.y
z from.z
vx vel.x
vy rise
vz vel.z
size0 size0
size1 size1
life life
drag drag
rot rot
spin spin
alpha alpha
seed seed
tile DUST
size_curve 0.5
gravity -1.1
r0 0.77
g0 0.66
b0 0.485
r1 0.65
g1 0.55
b1 0.4
alpha_curve 1.2
soft 0.08
