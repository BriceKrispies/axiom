burst wood.0
count 11.0 4
pool lit

# Splinters — `impacts.js:553-575`. Lifted a centimetre off the surface so
# a splinter does not spawn inside the plank it came from.
at = point
n = normal
from = mad3 n 0.01 at
axis_r = reflected
axis_s = add3 axis_r n
axis = scale3 axis_s 0.5
dir = cone axis 0.9 1.3
speed = range 2.5 7.5
vel = mul3 dir speed
# Every fourth splinter is a chip rather than a sliver. No draw — the loop
# index decides, and `%` is exact on small integers, so `< 0.5` is `== 0`.
index = index
phase = mod index 4.0
tile = select phase 0.5 CHIP SPLINTER
size = range 0.014 0.045
life = range 0.6 1.2
spun = unit
rot = scale spun 6.283185307179586
signed = signed
spin = scale signed 26.0
seed = unit

fields
x from.x
y from.y
z from.z
vx vel.x
vy vel.y
vz vel.z
tile tile
size0 size
size1 size
life life
rot rot
spin spin
seed seed
drag 0.8
gravity -18.0
r0 0.44
g0 0.3
b0 0.16
r1 0.36
g1 0.24
b1 0.13
alpha_curve 0.25
soft 0.06

burst wood.1
count 5.0 2
pool lit

# Resinous dust — `impacts.js:577-587`.
at = point
n = normal
axis_r = reflected
axis_s = add3 axis_r n
axis = scale3 axis_s 0.5
dir = cone axis 1.1 0.7
speed = range 0.6 2.0
# One drawn distance, read three times: the puff starts off the surface
# along the normal, so it is one offset and not three.
off = range 0.05 0.12
step = mul3 n off
from = add3 at step
vel = mul3 dir speed
rise = offset vel.y 0.35
energy = energy
near = range 0.04 0.09
size0 = mul near energy
far = range 0.24 0.44
size1 = mul far energy
life = range 0.45 0.9
spun = unit
rot = scale spun 6.283185307179586
signed = signed
spin = scale signed 1.4
alpha = range 0.5 0.8
seed = unit

fields
x from.x
y from.y
z from.z
vx vel.x
vy rise
vz vel.z
size0 size0
size1 size1
life life
rot rot
spin spin
alpha alpha
seed seed
tile DUST
size_curve 0.45
drag 3.4
gravity -0.9
r0 0.46
g0 0.34
b0 0.2
r1 0.38
g1 0.28
b1 0.17
alpha_curve 1.5
soft 0.09
turb 0.05
turb_freq 2.2
